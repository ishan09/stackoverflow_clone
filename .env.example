# ─── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# ─── Providers ────────────────────────────────────────────────────────────────
# Transcription: "local" (whisper CLI) | "openai" (Whisper API)
TRANSCRIPTION_PROVIDER=local

# LLM summarization: "ollama" (local) | "openai" (GPT)
LLM_PROVIDER=ollama

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── OpenAI (required when TRANSCRIPTION_PROVIDER=openai or LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Postgres (used by Phoenix + Oban) ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=stackoverflow_clone_dev

# ─── SQLite (used for reels table) ───────────────────────────────────────────
# Only required in production; dev/test use priv/reels_dev.db / :memory:
# REELS_DB_PATH=/data/reels.db

# ─── Phoenix ──────────────────────────────────────────────────────────────────
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
PHX_SERVER=true

# ─── Tuning ───────────────────────────────────────────────────────────────────
# Max characters of transcript shown in Slack reply (default 500)
TRANSCRIPT_MAX_LENGTH=500
