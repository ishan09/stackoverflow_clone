FROM elixir:1.18-otp-27-alpine

# cmake   — required to build exqlite NIF (bundled SQLite in ecto_sqlite3)
# ffmpeg  — audio extraction from downloaded reels
# python3 + yt-dlp — video download
# curl    — yt-dlp binary fetch
RUN apk add --no-cache \
    build-base \
    cmake \
    inotify-tools \
    postgresql-client \
    ffmpeg \
    python3 \
    py3-pip \
    curl

# yt-dlp — standalone binary, no Python dependency at runtime
RUN curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
    -o /usr/local/bin/yt-dlp \
    && chmod +x /usr/local/bin/yt-dlp

# openai-whisper — local transcription support.
# Remove this line to keep the image lean when using TRANSCRIPTION_PROVIDER=openai.
# First run will download the model (~140MB for "base") into /root/.cache/whisper.
RUN pip3 install --break-system-packages openai-whisper

# Install hex and rebar
RUN mix local.hex --force && \
    mix local.rebar --force

WORKDIR /app

# Fetch deps before copying source so layer is cached on code-only changes
COPY mix.exs mix.lock ./
RUN mix deps.get

COPY . .

COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

RUN mix compile

EXPOSE 4000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
